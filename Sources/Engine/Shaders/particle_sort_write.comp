#version 450

// Back-to-front sorting, last step: the sorted slots become the draw list (the draw arguments
// particle_compact.comp wrote already count them).

layout(local_size_x = 256) in;

layout(set = 2, binding = 26, std430) writeonly buffer DrawList { uint drawList[]; };
layout(set = 2, binding = 30, std430) readonly buffer Args { uint args[]; };
layout(set = 2, binding = 31, std430) readonly buffer Keys { uvec2 keys[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < args[1]) drawList[i] = keys[i].y;
}
