#version 450
#extension GL_GOOGLE_include_directive : require

// FSR 3.1 upscaler, pass 8 (SDK: ffx_fsr3upscaler_rcas_pass): robust contrast-adaptive
// sharpening of the accumulated history into the output.
// See fsr3_callbacks.glsl for the bindings and FidelityFX/LICENSE.txt for the license.

#define FSR3UPSCALER_BIND_SRV_RCAS_INPUT            9   // texture 1
#define FSR3UPSCALER_BIND_UAV_UPSCALED_OUTPUT       32  // storage texture 0

#include "fsr3_callbacks.glsl"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_rcas.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    RCAS(gl_LocalInvocationID.xyz, gl_WorkGroupID.xyz, gl_GlobalInvocationID.xyz);
}
