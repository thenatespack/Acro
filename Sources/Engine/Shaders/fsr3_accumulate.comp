#version 450
#extension GL_GOOGLE_include_directive : require

// FSR 3.1 upscaler, pass 7 (SDK: ffx_fsr3upscaler_accumulate_pass, sharpening permutation): per
// output pixel, Lanczos upsampling of the jittered input, history reprojection (Lanczos 2),
// rectification against the input's variance box, lock update, and the blend into the next
// history (rgb, lock in alpha). RCAS (fsr3_rcas.comp) then writes the output from it.
// See fsr3_callbacks.glsl for the bindings and FidelityFX/LICENSE.txt for the license.

#define FSR3UPSCALER_BIND_SRV_DILATED_REACTIVE_MASKS                9   // texture 1
#define FSR3UPSCALER_BIND_SRV_DILATED_MOTION_VECTORS                10  // texture 2
#define FSR3UPSCALER_BIND_SRV_INTERNAL_UPSCALED                     11  // texture 3
#define FSR3UPSCALER_BIND_SRV_FARTHEST_DEPTH_MIP1                   12  // texture 4
#define FSR3UPSCALER_BIND_SRV_LUMA_INSTABILITY                      13  // texture 5
#define FSR3UPSCALER_BIND_SRV_INPUT_COLOR                           14  // texture 6
#define FSR3UPSCALER_BIND_UAV_INTERNAL_UPSCALED                     32  // storage texture 0
#define FSR3UPSCALER_BIND_UAV_NEW_LOCKS                             33  // storage texture 1
#define FSR3UPSCALER_BIND_SAMPLER_LINEAR_CLAMP                      17  // sampler 1

#include "fsr3_callbacks.glsl"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_sample.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_upsample.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_reproject.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_accumulate.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    Accumulate(FfxInt32x2(gl_GlobalInvocationID.xy));
}
