#version 450
#extension GL_GOOGLE_include_directive : require

// FSR 3.1 upscaler, pass 4 (SDK: ffx_fsr3upscaler_shading_change_pass): shading change at half
// render resolution from levels 0-2 of the shading-change pyramid.
// See fsr3_callbacks.glsl for the bindings and FidelityFX/LICENSE.txt for the license.

#define FSR3UPSCALER_BIND_SRV_SPD_MIP0                              9   // texture 1
#define FSR3UPSCALER_BIND_SRV_SPD_MIP1                              10  // texture 2
#define FSR3UPSCALER_BIND_SRV_SPD_MIP2                              11  // texture 3
#define FSR3UPSCALER_BIND_UAV_SHADING_CHANGE                        32  // storage texture 0
#define FSR3UPSCALER_BIND_SAMPLER_LINEAR_CLAMP                      17  // sampler 1

#include "fsr3_callbacks.glsl"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "FidelityFX/fsr3upscaler/ffx_fsr3upscaler_shading_change.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    ShadingChange(FfxInt32x2(gl_GlobalInvocationID.xy));
}
