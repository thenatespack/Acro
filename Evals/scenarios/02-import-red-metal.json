{
  "id": "import-red-metal",
  "prompt": "Import this .glb (Box.glb in the project folder), make its materials red metal, and save the scene.",
  "fixtures": [{"copy": "Tests/EngineTests/Resources/glTF/Box.glb", "to": "Box.glb"}],
  "setup": [
    {"tool": "project.new", "arguments": {"path": "."}},
    {"tool": "scene.new", "arguments": {"template": "empty", "confirm": true}}
  ],
  "transcript": [
    {"tool": "asset.import", "arguments": {"sources": ["Box.glb"]}, "note": "answers once the background import is done"},
    {"tool": "asset.get", "arguments": {"path": "Box.glb"}},
    {"tool": "asset.extractMaterials", "arguments": {"asset": "@1.asset.id"}, "note": "imported materials are read-only (material.set on one says so); extracting makes editable .material files the model then uses"},
    {"tool": "material.set", "arguments": {"asset": "@2.materials.0", "material": {"baseColor": [0.8, 0.04, 0.03, 1], "metallic": 1, "roughness": 0.3}}, "note": "a merge: the other fields keep what the model had; ids and asset: references are interchangeable"},
    {"tool": "asset.instantiate", "arguments": {"asset": "@1.asset.id", "position": [0, 0.5, 0]}},
    {"tool": "scene.saveAs", "arguments": {"path": "box.json"}, "note": "a new file: no confirm needed"}
  ],
  "checks": [
    {"kind": "material", "description": "every renderer of the model uses a red metal material", "find": {"component": "MeshRenderer"},
     "fields": {"baseColor.0": {"atLeast": 0.5}, "baseColor.1": {"atMost": 0.2}, "baseColor.2": {"atMost": 0.2}, "metallic": {"atLeast": 0.8}}},
    {"kind": "file", "description": "the scene is saved and uses the model", "path": "box.json", "contains": "asset:"},
    {"kind": "tool", "description": "the import worked", "tool": "diagnostics.get", "expect": {"importErrors": [], "missingMeshes": []}}
  ]
}
