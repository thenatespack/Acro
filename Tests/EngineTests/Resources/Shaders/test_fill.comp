#version 450
// ComputeTests: mode 0 writes values[i] = i * scale + offset; mode 1 updates values[i] = values[i] * scale + offset
// (so a second dispatch in the same pass must see the first one's writes).
layout(local_size_x = 64) in;

layout(set = 2, binding = 24, std430) buffer Values { uint values[]; };

layout(push_constant) uniform Push {
    uint count;
    uint scale;
    uint offset;
    uint mode;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count) return;
    values[i] = (push.mode == 0u ? i : values[i]) * push.scale + push.offset;
}
