    "mantle" : ["key.w", "pad.north"],
    "right" : ["key.d", "key.right", "axis.leftStickX+"]
  },
  "links" : [
    ["update.out", "each.in"],
    ["each.out0", "goRight.in"],
    ["right.down", "goRight.condition"],
