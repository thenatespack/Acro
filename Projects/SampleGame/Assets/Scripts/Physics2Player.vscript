    ["goLeft.true", "moveLeft.in"],
    ["goLeft.false", "stop.in"],
    ["speed.value", "rightVelocity.x"],
    ["rightVelocity.vector", "moveRight.value"],
    ["speed.value", "back.value"],
    ["back.result", "leftVelocity.x"],
    ["leftVelocity.vector", "moveLeft.value"],
    ["each.out1", "setCrouch.in"],
    ["crouchHeld.down", "setCrouch.value"],
    ["jumpPressed.out", "setJump.in"],
