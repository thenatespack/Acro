    {"id" : "goRight", "type" : "flow.branch", "x" : 400, "y" : -60},
    {"id" : "moveRight", "type" : "component.set", "x" : 760, "y" : -120, "config" : {"component" : "CharacterController", "field" : "moveVelocity"}},
    {"id" : "goLeft", "type" : "flow.branch", "x" : 600, "y" : 60},
    {"id" : "moveLeft", "type" : "component.set", "x" : 900, "y" : 0, "config" : {"component" : "CharacterController", "field" : "moveVelocity"}},
